# Copy to .env.local and fill in. Never commit .env.local.

# Stage 2: the Strategy agent
ANTHROPIC_API_KEY=
GLASSER_API_KEY=
QUERIT_API_KEY=

# RocketRide. Set the URI to run the Strategy agent as a pipeline.
# Local engine in Docker: ws://localhost:5565
ROCKETRIDE_URI=
ROCKETRIDE_AUTH=

# BAND. Add your user key (Settings, API Keys), then run: bun run band:setup
# That registers the four agents and the room and fills in the rest.
# Start the worker with: bun run agents
BAND_USER_API_KEY=
BAND_ROOM_ID=
BAND_STRATEGY_AGENT_ID=
BAND_STRATEGY_API_KEY=
BAND_RESEARCH_AGENT_ID=
BAND_RESEARCH_API_KEY=
BAND_SALES_AGENT_ID=
BAND_SALES_API_KEY=
BAND_REVIEW_AGENT_ID=
BAND_REVIEW_API_KEY=

# Stage 3
APIFY_TOKEN=

# Stage 5
TENKI_API_KEY=
